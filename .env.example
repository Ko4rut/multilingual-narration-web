# URL server-side của MNR Backend. Không dùng NEXT_PUBLIC_ vì Axios chạy qua Server Action.
BACKEND_API_URL=http://127.0.0.1:8000/api/v1

# Bắt buộc cấu hình secret riêng ngoài môi trường demo.
AUTH_SECRET=replace-with-a-private-random-value

# Chỉ dùng local nếu muốn điền sẵn form; để trống ở production.
LOCAL_LOGIN_EMAIL=
LOCAL_LOGIN_PASSWORD=
